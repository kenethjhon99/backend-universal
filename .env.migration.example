# Configuracion para el script scripts/migrate-legacy-to-saas.mjs
# Copia este archivo a .env.migration y ajusta credenciales.

# === BD LEGACY (POS viejo, schema PascalCase) ===
LEGACY_PGHOST=localhost
LEGACY_PGPORT=5432
LEGACY_PGDATABASE=pos_legacy
LEGACY_PGUSER=postgres
LEGACY_PGPASSWORD=postgres
LEGACY_PGSSLMODE=disable

# === BD SAAS (destino, schema snake_case con id_empresa) ===
SAAS_PGHOST=localhost
SAAS_PGPORT=5432
SAAS_PGDATABASE=pos_saas
SAAS_PGUSER=postgres
SAAS_PGPASSWORD=postgres
SAAS_PGSSLMODE=disable

# Si una seccion falla, detener todo el proceso (default false: sigue con la siguiente).
# MIGRATION_HALT_ON_ERROR=true
