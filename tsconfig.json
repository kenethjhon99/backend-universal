{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": false,
    "baseUrl": ".",
    "paths": {
      "@pos-saas/shared-schemas": ["../../packages/shared-schemas/src/index.js"],
      "@pos-saas/shared-schemas/*": ["../../packages/shared-schemas/src/*.js"]
    }
  },
  "include": ["src-saas/**/*.ts", "src-saas/**/*.tsx"],
  "exclude": ["node_modules", "dist", "src/**", "tests/**"]
}
