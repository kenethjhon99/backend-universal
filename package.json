{
  "name": "backend",
  "version": "1.0.0",
  "main": "src-saas/server.js",
  "type": "module",
  "scripts": {
    "start": "node src-saas/server.js",
    "dev": "nodemon",
    "dev:ts": "tsx watch src-saas/server.js",
    "worker": "node src-saas/worker.js",
    "worker:dev": "nodemon src-saas/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "db:migrate:dry-run": "node scripts/apply-migrations.mjs --dry-run",
    "db:migrate:baseline": "node scripts/apply-migrations.mjs --baseline",
    "db:migrate:baseline-pre-branding": "node scripts/apply-migrations.mjs --baseline-through=042_saas_addons.sql",
    "ops:check": "node scripts/production-check.mjs",
    "migrate:legacy:dry-run": "node scripts/migrate-legacy-to-saas.mjs --dry-run",
    "migrate:legacy:apply": "node scripts/migrate-legacy-to-saas.mjs --apply",
    "migrate:cxc:dry-run": "node scripts/post-migration-cxc.mjs --dry-run",
    "migrate:cxc:apply": "node scripts/post-migration-cxc.mjs --apply"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "POS SaaS multi-tenant API",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bullmq": "^5.27.0",
    "ioredis": "^5.4.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.1",
    "rate-limit-redis": "^4.2.0",
    "@sentry/node": "^8.45.0",
    "@sentry/profiling-node": "^8.45.0",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "multer": "^1.4.5-lts.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.18.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "stripe": "^17.5.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.5",
    "@pos-saas/shared-schemas": "workspace:*"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "nodemon": "^3.1.11",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
