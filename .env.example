# =========================================================================
# Backend SaaS — variables de entorno
# Copiá este archivo como `.env` y rellená los valores reales.
# =========================================================================

# ---------- Servidor ----------
NODE_ENV=development
PORT=4000

# ---------- Auth ----------
# JWT_SECRET: mínimo 32 caracteres. Rotalo en cada entorno.
# Generá uno con: openssl rand -hex 32
JWT_SECRET=__cambiar__minimo_32_caracteres_aleatorios__
JWT_EXPIRES=8h

# COOKIE_SECRET: usado para firmar cookies. Mínimo 32 chars.
# Generá con: openssl rand -hex 32
COOKIE_SECRET=__cambiar__minimo_32_caracteres__

# ---------- MFA TOTP ----------
# MFA_ENCRYPTION_KEY: 64 hex chars (32 bytes). Encripta los secrets TOTP at-rest.
# CRITICO: si lo perdés, los secrets MFA de todos los usuarios quedan
# irrecuperables — necesitarán re-enrollar. Backupealo en un secret manager.
# Generá con: openssl rand -hex 32
MFA_ENCRYPTION_KEY=
# Issuer mostrado en la app authenticator (Google Auth, Authy, 1Password).
MFA_ISSUER=POS SaaS
# Secret separado para los challenge tokens del flow login 2-step.
# Si vacío, se deriva del JWT_SECRET. Generá con: openssl rand -hex 32
MFA_CHALLENGE_SECRET=
# Validez del challenge token. Default 5m.
MFA_CHALLENGE_EXPIRES=5m
# MFA obligatorio para usuarios con rol SUPER_ADMIN. Default true.
# Si false, super_admins pueden operar sin MFA (no recomendado en produccion).
MFA_REQUIRED_FOR_SUPER_ADMIN=true

# ---------- CORS ----------
# Lista separada por comas de orígenes permitidos.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# ---------- Postgres ----------
# Si usás Docker Compose (recomendado), PGPORT=55432 expone el contenedor.
# Si usás Postgres nativo del SO, normalmente PGPORT=5432.
PGHOST=localhost
PGPORT=55432
PGDATABASE=pos_saas
# Desarrollo local puede usar postgres, pero PRODUCCION debe usar saas_app
# creado por la migracion 034, sin BYPASSRLS. El backend bloquea postgres/root
# en NODE_ENV=production salvo emergencia explicita.
PGUSER=postgres
PGPASSWORD=__cambiar__
# disable | require | prefer. Default auto-detecta: remoto = require, local = disable.
PGSSLMODE=disable
# Solo emergencia controlada: permite levantar produccion con superuser DB.
ALLOW_SUPERUSER_DB_IN_PRODUCTION=false

# ---------- Redis / colas (BullMQ) ----------
# Si no se define, BullMQ degrada a procesamiento in-process (solo dev).
# Para producción es OBLIGATORIO.
REDIS_URL=redis://localhost:6379

# ---------- Stripe (billing) ----------
# Si no se define, las rutas /api/saas/billing/* devuelven 503.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- Webhooks salientes (HMAC) ----------
# Secreto usado para firmar webhooks que tu SaaS envía a clientes.
WEBHOOK_HMAC_SECRET=

# ---------- Métricas / Observabilidad ----------
# /metrics: en producción REQUIERE METRICS_TOKEN.
#   - Si está vacío + NODE_ENV=production → /metrics responde 401 siempre.
#   - Si está vacío + dev → /metrics queda abierto.
# Generá con: openssl rand -hex 32
METRICS_TOKEN=

# ---------- OpenAPI / Swagger UI ----------
# Controla la exposición de /api/saas/docs y /api/saas/openapi.json.
# Valores:
#   public  - abierto (default en dev)
#   off     - 404, no expuesto (default en prod, recomendado)
#   token   - requiere API_DOCS_TOKEN via X-Docs-Token o Bearer
#   admin   - requiere JWT con rol SUPER_ADMIN o ADMIN_EMPRESA
API_DOCS_MODE=
API_DOCS_TOKEN=

# ---------- Storage S3-compatible (uploads) ----------
# Compatible con AWS S3, Cloudflare R2, MinIO, DO Spaces, Backblaze B2.
# Si S3_BUCKET no esta definido, los endpoints /api/saas/archivos responden 503.
S3_BUCKET=
S3_REGION=us-east-1
# Para AWS: dejar vacío. Para R2/MinIO/Spaces: URL del endpoint.
# Ejemplos:
#   R2: https://<account-id>.r2.cloudflarestorage.com
#   MinIO: http://localhost:9000
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Opcional: URL base de CDN para servir archivos publicos. Ej. https://cdn.tu-saas.com
S3_PUBLIC_URL_BASE=

# ---------- Sentry (opcional) ----------
# Si vacío, el SDK no se inicializa (todo el código es no-op).
SENTRY_DSN=
# environment tag (default: NODE_ENV)
SENTRY_ENVIRONMENT=
# release tag (recomendado: hash de commit corto, ej "v1.2.3" o git rev)
SENTRY_RELEASE=
# 0.0 - 1.0. Fracción de transacciones a trazar para performance.
SENTRY_TRACES_SAMPLE_RATE=0.1
# 0.0 - 1.0. Profiling CPU (necesita @sentry/profiling-node).
SENTRY_PROFILES_SAMPLE_RATE=0

# ---------- Email transaccional (opcional, según provider) ----------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="POS SaaS <no-reply@tu-dominio.com>"
