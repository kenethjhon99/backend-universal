NODE_ENV=production
PORT=10000

# Neon Postgres. En produccion usa el host pooler de Neon si esta disponible.
PGHOST=ep-xxxx-pooler.region.aws.neon.tech
PGPORT=5432
PGDATABASE=pos_saas
PGUSER=saas_app
PGPASSWORD=__password_del_rol_saas_app__
PGSSLMODE=require
ALLOW_SUPERUSER_DB_IN_PRODUCTION=false

# Frontend / CORS
FRONTEND_URL=https://tu-frontend.vercel.app
CORS_ORIGINS=https://tu-frontend.vercel.app,https://app.tu-dominio.com
APP_DOMAIN=tu-dominio.com

# Cookies
# Para Vercel + Render con dominios distintos usar none. Para app/api bajo el
# mismo dominio raiz puedes usar strict.
COOKIE_SAMESITE=none
COOKIE_DOMAIN=

# Auth
JWT_SECRET=__generar_con_openssl_rand_hex_32__
JWT_EXPIRES=8h
JWT_ACCESS_EXPIRES=30m
REFRESH_TTL_DAYS=30
COMPANY_SELECTION_SECRET=__generar_con_openssl_rand_hex_32__

# MFA
MFA_REQUIRED_FOR_ADMINS=true
MFA_ENCRYPTION_KEY=__generar_con_openssl_rand_hex_32__
MFA_CHALLENGE_SECRET=__generar_con_openssl_rand_hex_32__
MFA_ISSUER=POS SaaS

# Seguridad operativa
LOGIN_ATTEMPT_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
LOGIN_MAX_FAILED_ATTEMPTS=5
METRICS_TOKEN=__generar_token_largo__
API_DOCS_MODE=token
API_DOCS_TOKEN=__generar_token_largo__

# Redis opcional pero recomendado en produccion para rate limit y colas.
REDIS_URL=

# Billing Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://tu-frontend.vercel.app/pagos/exito
STRIPE_CANCEL_URL=https://tu-frontend.vercel.app/pagos/cancelado

# Storage S3 compatible
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_BASE=

# Observabilidad
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0

# Branding SaaS fallback
SAAS_BRAND_NAME=Sistema Universal POS
SAAS_BRAND_SLOGAN=El sistema se adapta a tu negocio
SAAS_BRAND_LOGO_URL=
SAAS_BRAND_FAVICON_URL=
SAAS_BRAND_PRIMARY=#2563eb
SAAS_BRAND_SECONDARY=#0f172a
SAAS_BRAND_ACCENT=#16a34a
SAAS_BRAND_HERO_IMAGE_URL=
